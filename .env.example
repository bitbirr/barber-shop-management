# Supabase Postgres
# Runtime queries can use Transaction pooler (:6543).
# Prisma DDL (db push / migrate) MUST use Session pooler (:5432) or Direct host — :6543 hangs.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://tenant.bitbirr.net
BETTER_AUTH_TRUSTED_ORIGINS=https://tenant.bitbirr.net,https://bitbirr.net,https://www.bitbirr.net,https://*.bitbirr.net
AUTH_COOKIE_DOMAIN=
